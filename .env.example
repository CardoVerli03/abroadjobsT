# Abroad JobsT - Environment Variables
# Copy this file to .env and fill in your values

# Turso Database
TURSO_URL=your_turso_url_here
TURSO_TOKEN=your_turso_token_here

# Job API Keys
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_API_KEY=your_adzuna_api_key
REED_API_KEY=your_reed_api_key
CAREERJET_API_KEY=your_careerjet_api_key

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
ADMIN_TELEGRAM_ID=your_telegram_id

# Monetization
LTC_ADDRESS=your_litecoin_address
GG_SMARTLINK=your_gg_smartlink_url
UPGRADE_WEBSITE_URL=https://your-upgrade-website.com

# Security
SCRAPE_SECRET=your_random_secret_key

# Support
SUPPORT_CHANNEL=https://t.me/your_support_channel

# Local database for Prisma (used by existing setup)
DATABASE_URL=file:./dev.db
